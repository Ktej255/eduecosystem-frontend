{
    "ServiceName": "eduecosystem-backend-v2",
    "SourceConfiguration": {
        "CodeRepository": {
            "RepositoryUrl": "https://github.com/Ktej255/eduecosystem-backend",
            "SourceCodeVersion": {
                "Type": "BRANCH",
                "Value": "main"
            },
            "CodeConfiguration": {
                "ConfigurationSource": "REPOSITORY"
            }
        },
        "AutoDeploymentsEnabled": true,
        "AuthenticationConfiguration": {
            "ConnectionArn": "arn:aws:apprunner:us-east-1:816902390376:connection/github-connection/2c8ea7036c124c7e895272d0a2997bd5"
        }
    },
    "InstanceConfiguration": {
        "Cpu": "1024",
        "Memory": "2048"
    },
    "HealthCheckConfiguration": {
        "Protocol": "HTTP",
        "Path": "/health",
        "Interval": 10,
        "Timeout": 5,
        "HealthyThreshold": 1,
        "UnhealthyThreshold": 5
    }
}