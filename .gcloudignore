# EXCLUSIVE PRODUCTION DEPLOYMENT
# Ignore everything by default
*

# Whitelist ONLY production critical paths
!backend/
!frontend/
!**/package.json
!**/package-lock.json
!**/requirements.txt
!cloudbuild*.yaml
!.gcloudignore

# Recursively blacklist build artifacts, deps, and specific heavy folders
# These will be ignored even if they are inside the whitelisted folders above
node_modules/
**/node_modules/
venv/
**/venv/
.venv/
**/.venv/
__pycache__/
**/*.pyc
.next/
**/.next/
.next-qa/
**/.next-qa/
**/dist/
.git/
.env*
*.log
**/*.log
scratch/
temp/
*.tgz
!backend/.env.example
!frontend/.env.example

# Specific Heavy Folders to Avoid (45GB+ Prevention)
/Sarit Classes website code/
/remotion-animations/
/DevTools/
/restaurant-portal/
/google-cloud-sdk/
/testsprite_tests/
/tmp/
/Doc/
/Batch 02/
/.playwright-mcp/
/artifacts/
/mobile/
/nginx/
/libs/
/genkit/
/.agent/
