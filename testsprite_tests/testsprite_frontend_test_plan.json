[
  {
    "id": "TC001",
    "title": "Register a new Student account and reach verification/onboarding screen",
    "description": "Verifies a new user can register as a Student and is taken to an email verification prompt or onboarding/welcome screen.",
    "category": "User Registration",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /register"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Register\" is visible"
      },
      {
        "type": "action",
        "description": "Fill \"new.student+1@example.com\" into the email input field"
      },
      {
        "type": "action",
        "description": "Fill \"ValidPass!234\" into the password input field"
      },
      {
        "type": "action",
        "description": "Select \"Student\" from the account type dropdown"
      },
      {
        "type": "action",
        "description": "Click the \"Register\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Verify your email\" is visible"
      }
    ]
  },
