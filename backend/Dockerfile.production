# --- EduEcosystem Backend Production Dockerfile ---
FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PORT 8080

WORKDIR /app

# Install system dependencies (Debian/Slim style)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install from backend directory
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir psycopg2-binary uvicorn uvloop numpy

# Copy application code from backend directory
COPY backend/ .

# Ensure scripts are executable
RUN chmod +x /app/scripts/*.py

# Command to run on Cloud Run (Port injected by GCP)
CMD exec uvicorn main:app --host 0.0.0.0 --port $PORT
